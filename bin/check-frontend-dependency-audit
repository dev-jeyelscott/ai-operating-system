#!/usr/bin/env bash

set -Eeuo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cd "$PROJECT_ROOT"

# Keep the approved temporary exception narrow and reviewable.
readonly EXCEPTION_ADVISORY_ID="GHSA-mh99-v99m-4gvg"
readonly EXCEPTION_EXPIRES_ON="2026-09-03"

# The override exists only to make the expiry behavior deterministically testable.
current_date="${DEPENDENCY_AUDIT_DATE:-$(date -u +%F)}"

# Reject invalid dates before applying the exception policy.
if [[ ! "$current_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    printf 'ERROR: DEPENDENCY_AUDIT_DATE must use YYYY-MM-DD format.\n' >&2

    exit 2
fi

# Production dependencies never receive advisory exceptions.
pnpm audit \
    --prod \
    --audit-level=high

# Prefer a completely clean development dependency audit.
if pnpm audit \
    --dev \
    --audit-level=high; then
    printf 'Frontend dependency audits passed without exceptions.\n'

    exit 0
fi

# Fail closed when the approved development-only exception expires.
if [[ "$current_date" > "$EXCEPTION_EXPIRES_ON" ]]; then
    printf \
        'ERROR: dependency audit exception %s expired on %s.\n' \
        "$EXCEPTION_ADVISORY_ID" \
        "$EXCEPTION_EXPIRES_ON" \
        >&2

    printf '%s\n' \
        'Update or replace the affected development dependency before continuing.' \
        >&2

    exit 1
fi

# Retry only the development dependency audit with the single approved advisory.
pnpm audit \
    --dev \
    --audit-level=high \
    --ignore "$EXCEPTION_ADVISORY_ID"

printf \
    'Development dependency audit passed with temporary exception %s; expiry: %s.\n' \
    "$EXCEPTION_ADVISORY_ID" \
    "$EXCEPTION_EXPIRES_ON"
