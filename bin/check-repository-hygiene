#!/usr/bin/env bash

set -Eeuo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cd "$PROJECT_ROOT"

# Keep ordering and pattern matching deterministic between local and CI systems.
export LC_ALL=C

readonly -a REQUIRED_NON_EMPTY_DIRECTORIES=(
    "docs/security"
    "tests/Feature/Policies"
    "tests/Feature/Security"
    "tests/Unit/Policies"
    "tests/Unit/Security"
)

readonly -a SHARED_AGENT_CONFIGURATION_PATHS=(
    ".codex/config.toml"
    "AGENTS.md"
)

readonly -a MACHINE_SPECIFIC_AGENT_PATTERNS=(
    '/home/[[:alnum:]_.-]+/'
    '/Users/[[:alnum:]_.-]+/'
    '[[:alpha:]]:\\+Users\\+[[:alnum:]_.-]+\\+'
    '[[:alpha:]]:/+Users/+[[:alnum:]_.-]+/+'
    'wsl\.exe'
    'always[[:space:]]+run.*wsl[[:space:]]+-d'
)

readonly EVIDENCE_DIRECTORY="docs/evidence"
readonly RELEASE_DIRECTORY="docs/releases"
readonly SECURITY_DIRECTORY="docs/security"
readonly WORKFLOW_DIRECTORY=".github/workflows"

readonly EVIDENCE_PLACEHOLDER_PATTERN='Add the .* here|Document any .* here|<number>|<scope>|Actual .* Name|INSERT NAME|REPLACE ME|(^|[^[:alnum:]_])(TODO|TBD|Pending)([^[:alnum:]_]|$)'

failure_count=0

declare -a tracked_backup_files=()
declare -a empty_required_files=()
declare -a empty_markdown_files=()
declare -a unresolved_evidence_placeholders=()
declare -a invalid_bash_scripts=()
declare -a malformed_bash_parameter_expansions=()
declare -a unclosed_markdown_fences=()
declare -a mutable_workflow_actions=()
declare -a machine_specific_agent_configuration=()

# Print one grouped error category with every actionable repository path.
report_failures() {
    local heading="$1"

    shift

    local item

    printf 'ERROR: %s\n' "$heading" >&2

    for item in "$@"; do
        printf '  - %s\n' "$item" >&2
    done

    printf '\n' >&2
}

# Detect backup and editor-temporary files that already exist in Git's index.
check_tracked_backup_files() {
    local path

    while IFS= read -r -d '' path; do
        case "$path" in
            *.backup | *.bak | *.orig | *~)
                tracked_backup_files+=("$path")
                ;;
        esac
    done < <(git ls-files -z)

    if (( ${#tracked_backup_files[@]} > 0 )); then
        report_failures \
            'tracked backup or editor-temporary files were found:' \
            "${tracked_backup_files[@]}"

        failure_count=$((failure_count + 1))
    fi
}

# Detect required security documentation and policy/security tests with no content.
check_empty_required_files() {
    local directory
    local path

    for directory in "${REQUIRED_NON_EMPTY_DIRECTORIES[@]}"; do
        [[ -d "$directory" ]] || continue

        while IFS= read -r -d '' path; do
            empty_required_files+=("$path")
        done < <(
            find "$directory" \
                -type f \
                -size 0 \
                -print0 \
                | sort -z
        )
    done

    if (( ${#empty_required_files[@]} > 0 )); then
        report_failures \
            'zero-byte required security documentation or tests were found:' \
            "${empty_required_files[@]}"

        failure_count=$((failure_count + 1))
    fi
}

# Reject empty tracked Markdown files. Documentation is release evidence and a
# tracked empty file is never a useful placeholder.
check_empty_markdown_files() {
    local path

    while IFS= read -r -d '' path; do
        if [[ ! -s "$path" ]]; then
            empty_markdown_files+=("$path")
        fi
    done < <(git ls-files -z '*.md')

    if (( ${#empty_markdown_files[@]} > 0 )); then
        report_failures \
            'zero-byte tracked Markdown files were found:' \
            "${empty_markdown_files[@]}"

        failure_count=$((failure_count + 1))
    fi
}

# Detect known instructional placeholders in release-evidence Markdown files.
check_unresolved_evidence_placeholders() {
    local match
    local -a directories=()

    [[ -d "$EVIDENCE_DIRECTORY" ]] && directories+=("$EVIDENCE_DIRECTORY")
    [[ -d "$RELEASE_DIRECTORY" ]] && directories+=("$RELEASE_DIRECTORY")
    [[ -d "$SECURITY_DIRECTORY" ]] && directories+=("$SECURITY_DIRECTORY")

    (( ${#directories[@]} > 0 )) || return

    while IFS= read -r match; do
        unresolved_evidence_placeholders+=("$match")
    done < <(
        {
            grep \
                --recursive \
                --line-number \
                --with-filename \
                --include='*.md' \
                --extended-regexp \
                -- "$EVIDENCE_PLACEHOLDER_PATTERN" \
                "${directories[@]}" \
                || true
        } | sort
    )

    if (( ${#unresolved_evidence_placeholders[@]} > 0 )); then
        report_failures \
            'unresolved release-evidence placeholders were found:' \
            "${unresolved_evidence_placeholders[@]}"

        failure_count=$((failure_count + 1))
    fi
}

# Parse every tracked Bash entry point before CI executes it.
check_bash_syntax() {
    local path
    local first_line

    while IFS= read -r -d '' path; do
        first_line=''
        IFS= read -r first_line < "$path" || true

        if [[ "$first_line" != '#!/usr/bin/env bash' ]]; then
            continue
        fi

        if ! bash -n "$path"; then
            invalid_bash_scripts+=("$path")
        fi
    done < <(git ls-files -z 'bin/*')

    if (( ${#invalid_bash_scripts[@]} > 0 )); then
        report_failures \
            'tracked Bash scripts with invalid syntax were found:' \
            "${invalid_bash_scripts[@]}"

        failure_count=$((failure_count + 1))
    fi
}

# Bash accepts a newline after `${` as a command substitution, which is almost
# always a typo in a parameter expansion and fails only at runtime.
check_malformed_bash_parameter_expansions() {
    local path

    while IFS= read -r -d '' path; do
        if grep --line-number --extended-regexp '\$\{[[:space:]]*$' "$path" \
            >/dev/null; then
            malformed_bash_parameter_expansions+=("$path")
        fi
    done < <(git ls-files -z 'bin/*')

    if (( ${#malformed_bash_parameter_expansions[@]} > 0 )); then
        report_failures \
            'tracked Bash scripts with malformed parameter expansions were found:' \
            "${malformed_bash_parameter_expansions[@]}"

        failure_count=$((failure_count + 1))
    fi
}

# Release evidence must render correctly in code-review and GitHub release UI.
check_unclosed_markdown_fences() {
    local path

    for path in "$EVIDENCE_DIRECTORY" "$RELEASE_DIRECTORY"; do
        [[ -d "$path" ]] || continue

        while IFS= read -r -d '' markdown; do
            if ! awk '
                /^```/ { fences += 1 }
                END { exit fences % 2 }
            ' "$markdown"; then
                unclosed_markdown_fences+=("$markdown")
            fi
        done < <(find "$path" -type f -name '*.md' -print0 | sort -z)
    done

    if (( ${#unclosed_markdown_fences[@]} > 0 )); then
        report_failures \
            'Markdown files with unclosed code fences were found:' \
            "${unclosed_markdown_fences[@]}"

        failure_count=$((failure_count + 1))
    fi
}

# Reject mutable third-party GitHub Actions references.
check_mutable_workflow_actions() {
    local path
    local line
    local line_number
    local reference

    [[ -d "$WORKFLOW_DIRECTORY" ]] || return 0

    while IFS= read -r -d '' path; do
        line_number=0

        while IFS= read -r line || [[ -n "$line" ]]; do
            line_number=$((line_number + 1))

            if [[ ! "$line" =~ ^[[:space:]]*(-[[:space:]]+)?uses:[[:space:]]*([^[:space:]#]+) ]]; then
                continue
            fi

            reference="${BASH_REMATCH[2]}"

            if [[ "$reference" == ./* ]]; then
                continue
            fi

            if [[ ! "$reference" =~ @[[:xdigit:]]{40}$ ]]; then
                mutable_workflow_actions+=(
                    "$path:$line_number: $reference"
                )
            fi
        done < "$path"
    done < <(
        find "$WORKFLOW_DIRECTORY" \
            -type f \
            \( -name '*.yml' -o -name '*.yaml' \) \
            -print0 \
            | sort -z
    )

    if (( ${#mutable_workflow_actions[@]} > 0 )); then
        report_failures \
            'mutable third-party GitHub Actions references were found:' \
            "${mutable_workflow_actions[@]}"

        failure_count=$((failure_count + 1))
    fi
}

# Reject personal paths and workstation-only commands in tracked shared agent configuration.
check_machine_specific_agent_configuration() {
    local path
    local pattern
    local match

    for path in "${SHARED_AGENT_CONFIGURATION_PATHS[@]}"; do
        if ! git ls-files --error-unmatch -- "$path" >/dev/null 2>&1; then
            continue
        fi

        for pattern in "${MACHINE_SPECIFIC_AGENT_PATTERNS[@]}"; do
            while IFS= read -r match; do
                machine_specific_agent_configuration+=("$match")
            done < <(
                grep \
                    --ignore-case \
                    --line-number \
                    --with-filename \
                    --extended-regexp \
                    -- "$pattern" \
                    "$path" \
                    || true
            )
        done
    done

    if (( ${#machine_specific_agent_configuration[@]} > 0 )); then
        report_failures \
            'machine-specific tracked agent configuration was found:' \
            "${machine_specific_agent_configuration[@]}"

        failure_count=$((failure_count + 1))
    fi
}

# Reject execution outside Git because tracked-file checks would be incomplete.
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    printf '%s\n' \
        'ERROR: repository hygiene must run inside a Git working tree.' \
        >&2

    exit 2
}

check_tracked_backup_files
check_empty_required_files
check_empty_markdown_files
check_unresolved_evidence_placeholders
check_bash_syntax
check_malformed_bash_parameter_expansions
check_unclosed_markdown_fences
check_mutable_workflow_actions
check_machine_specific_agent_configuration

if (( failure_count > 0 )); then
    if [[ "$failure_count" -eq 1 ]]; then
        printf 'Repository hygiene failed with 1 error category.\n' >&2
    else
        printf \
            'Repository hygiene failed with %d error categories.\n' \
            "$failure_count" \
            >&2
    fi

    exit 1
fi

printf 'Repository hygiene checks passed.\n'
