#!/usr/bin/env bash

set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repository_root}"

asset_directory="public/assets/office"
maximum_bytes="${OFFICE_ASSET_MAX_BYTES:-2097152}"
has_failure=0

mkdir -p "${asset_directory}"

mapfile -t unexpected_files < <(
    find "${asset_directory}" \
        -maxdepth 1 \
        -type f \
        ! -name '*.glb' \
        ! -name '.gitkeep' \
        -print |
        sort
)

if (( "${#unexpected_files[@]}" > 0 )); then
    echo "Only optimized GLB files may be committed to ${asset_directory}:" >&2

    printf '  %s\n' "${unexpected_files[@]}" >&2

    has_failure=1
fi

shopt -s nullglob
assets=("${asset_directory}"/*.glb)
shopt -u nullglob

if (( "${#assets[@]}" == 0 )); then
    if (( has_failure != 0 )); then
        exit 1
    fi

    echo "No optimized office GLB assets are currently committed."
    exit 0
fi

for asset in "${assets[@]}"; do
    filename="$(basename "${asset}")"

    if [[ ! "${filename}" =~ ^[a-z0-9]+(-[a-z0-9]+)*\.glb$ ]]; then
        echo "Invalid office asset filename: ${filename}" >&2
        has_failure=1
        continue
    fi

    if ! pnpm exec gltf-transform inspect "${asset}" > /dev/null; then
        echo "Invalid or unreadable office GLB: ${asset}" >&2
        has_failure=1
        continue
    fi

    asset_bytes="$(stat -c '%s' "${asset}")"

    if (( asset_bytes > maximum_bytes )); then
        echo "Office asset exceeds the ${maximum_bytes}-byte budget: ${asset} (${asset_bytes} bytes)." >&2
        has_failure=1
        continue
    fi

    echo "Validated ${asset} (${asset_bytes} bytes)."
done

exit "${has_failure}"
