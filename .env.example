APP_NAME="AI Operating System"
APP_ENV=local
APP_KEY=

# Previous application encryption keys used only during controlled rotation.
APP_PREVIOUS_KEYS=

APP_DEBUG=true
APP_URL=http://localhost
APP_RELEASE=local

# Reverse-proxy trust boundary
#
# Local Sail traffic reaches Laravel without a trusted external proxy.
# Keep this empty unless local traffic is intentionally routed through one.
TRUSTED_PROXIES=

# Supported values: x_forwarded, forwarded, aws_elb
TRUSTED_PROXY_HEADERS=x_forwarded

LOG_CHANNEL=stack
LOG_STACK=json
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=ai_operating_system
DB_USERNAME=sail
DB_PASSWORD=password
FORWARD_DB_PORT=54320

# Store authenticated sessions in the authoritative database.
SESSION_DRIVER=database

# Expire sessions after two hours of inactivity.
SESSION_LIFETIME=120

# Keep the session when the browser closes unless policy changes later.
SESSION_EXPIRE_ON_CLOSE=false

# Encrypt session payloads before writing them to the session store.
SESSION_ENCRYPT=true

# Prevent JavaScript from reading the session cookie.
SESSION_HTTP_ONLY=true

# Mitigate cross-site request forgery while preserving normal navigation.
SESSION_SAME_SITE=lax

# Local HTTP development must remain false.
# Production must explicitly set this to true and use HTTPS.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=redis
CACHE_LIMITER_STORE=redis
CACHE_STORE=redis

FILESYSTEM_DISK=local
ARTIFACT_FILESYSTEM_DISK=s3

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=63790

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="noreply@aios.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=sail
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=aios-local
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

MINIO_ROOT_USER=sail
MINIO_ROOT_PASSWORD=password
FORWARD_MINIO_PORT=9000
FORWARD_MINIO_CONSOLE_PORT=8900

REVERB_APP_ID=local-app
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
FORWARD_REVERB_PORT=8080

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

PLAYWRIGHT_BASE_URL=http://localhost

# Authentication rate limits
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_TWO_FACTOR_PER_MINUTE=5
RATE_LIMIT_PASSKEYS_PER_MINUTE=10

# Privileged project command rate limits
RATE_LIMIT_PROJECT_STORE_PER_MINUTE=10
RATE_LIMIT_PROJECT_STORE_PER_HOUR=100
RATE_LIMIT_PROJECT_UPDATE_PER_MINUTE=20
RATE_LIMIT_PROJECT_UPDATE_PER_HOUR=200
RATE_LIMIT_PROJECT_ARCHIVE_PER_MINUTE=10
RATE_LIMIT_PROJECT_ARCHIVE_PER_HOUR=50
RATE_LIMIT_PROJECT_RESTORE_PER_MINUTE=10
RATE_LIMIT_PROJECT_RESTORE_PER_HOUR=50
RATE_LIMIT_PROJECT_CREDENTIALS_PER_MINUTE=5
RATE_LIMIT_PROJECT_CREDENTIALS_PER_HOUR=20
RATE_LIMIT_NOTION_TEST_PER_MINUTE=5
RATE_LIMIT_NOTION_TEST_PER_HOUR=20

NOTION_API_BASE_URL=https://api.notion.com/v1
NOTION_API_VERSION=2026-03-11
NOTION_CONNECT_TIMEOUT_SECONDS=3
NOTION_TIMEOUT_SECONDS=8
NOTION_RETRY_ATTEMPTS=3
# Execution resilience
EXECUTION_TIMEOUT_SECONDS=900
EXECUTION_RETRY_BASE_DELAY_SECONDS=30
EXECUTION_RETRY_MAX_DELAY_SECONDS=900
EXECUTION_RETRY_JITTER_PERCENT=20
EXECUTION_RECOVERY_BATCH_SIZE=200

# Transport-neutral projection stream
EVENT_STREAM_DRIVER=broadcast
EVENT_STREAM_BROADCAST_CONNECTION=reverb

# Integration circuit breakers and queue backpressure
INTEGRATION_CIRCUIT_FAILURE_THRESHOLD=5
INTEGRATION_CIRCUIT_FAILURE_WINDOW_SECONDS=60
INTEGRATION_CIRCUIT_OPEN_SECONDS=60
INTEGRATION_CIRCUIT_HALF_OPEN_LEASE_SECONDS=15
INTEGRATION_CIRCUIT_LOCK_SECONDS=5
INTEGRATION_CIRCUIT_LOCK_WAIT_SECONDS=2

INTEGRATIONS_QUEUE_CONNECTION=redis
INTEGRATIONS_QUEUE_NAME=integrations
NOTION_PUBLICATION_JOBS_PER_MINUTE=12
NOTION_OVERLAP_RELEASE_SECONDS=15
NOTION_OVERLAP_EXPIRE_SECONDS=90

CODEX_APP_SERVER_EXECUTABLE=/usr/local/bin/codex
CODEX_APP_SERVER_BINARY_VERSION=<exact-version-from-codex---version>
CODEX_APP_SERVER_PROTOCOL_VERSION=stable
CODEX_APP_SERVER_SCHEMA_FINGERPRINT=<64-character-sha256>